{
  "name": "rholydd-sequencer",
  "private": true,
  "version": "1.1.0",
  "description": "パラメーターを設定するだけで、ドラムンベースを展開しながら止めるまで鳴らし続けるブラウザのジェネレーティブ・シーケンサー",
  "type": "module",
  "license": "Apache-2.0",
  "repository": "github:Double-oxygeN/rholydd-sequencer",
  "homepage": "https://gh.double-oxygen.net/rholydd-sequencer/",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "cert": "node tools/make-cert.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "simulate": "node tools/simulate.ts",
    "samples": "node tools/make-samples.ts",
    "icons": "node tools/make-icons.ts"
  },
  "dependencies": {
    "lucide": "1.49.0",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
